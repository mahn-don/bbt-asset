# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# SQLite by default. A relative path is resolved against the project root by
# src/lib/load-env.ts so the app, CLI and tests all open the same file.
DATABASE_URL="file:./prisma/dev.db"

# ---------------------------------------------------------------------------
# Credential encryption (REQUIRED)
# ---------------------------------------------------------------------------
# Master key for AES-256-GCM encryption of provider API credentials.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep it OUT of the database and out of version control. Losing it means every
# stored provider credential must be re-entered.
INTEGRATION_CREDENTIAL_ENCRYPTION_KEY="change-me-to-a-long-random-value"

# Identifier stamped into each ciphertext, so keys can be rotated.
INTEGRATION_CREDENTIAL_KEY_ID="k1"

# Retired keys, so ciphertexts written before a rotation stay readable.
# Format: keyId:secret,keyId:secret
# INTEGRATION_CREDENTIAL_PREVIOUS_KEYS=""

# ---------------------------------------------------------------------------
# Sessions (REQUIRED)
# ---------------------------------------------------------------------------
# HMAC key for session tokens. Rotating it signs everyone out.
SESSION_SECRET="change-me-to-a-long-random-value"
SESSION_TTL_HOURS="336"

# ---------------------------------------------------------------------------
# AI
# ---------------------------------------------------------------------------
# "anthropic" uses the Claude API. Any other value (or a missing API key) falls
# back to "heuristic": a deterministic, offline, rule-based estimator. Results
# from it are stored with aiProvider="heuristic" and labelled in the UI, never
# presented as model output.
AI_PROVIDER="anthropic"
AI_MODEL="claude-opus-5"

# Server-side only. Never exposed to the browser.
# ANTHROPIC_API_KEY="sk-ant-..."

AI_ENABLED="true"
AI_SCOPE_EVALUATION_ENABLED="true"
AI_CHANGE_ANALYSIS_ENABLED="true"
AI_AUTO_EVALUATE_NEW_SCOPES="true"
AI_AUTO_REEVALUATE_CHANGED_SCOPES="true"
# low | medium | high | xhigh | max
AI_EFFORT="medium"

# ---------------------------------------------------------------------------
# Sync / authorization
# ---------------------------------------------------------------------------
# Provider data older than this fails the scope authorization gate.
SCOPE_FRESHNESS_MAX_AGE_HOURS="168"

# Pagination safety limit: maximum pages walked per collection per sync.
SYNC_MAX_PAGES="200"

PROVIDER_HTTP_TIMEOUT_MS="20000"
PROVIDER_HTTP_MAX_RETRIES="3"

# ---------------------------------------------------------------------------
# Worker / logging
# ---------------------------------------------------------------------------
WORKER_POLL_INTERVAL_MS="5000"
WORKER_BATCH_SIZE="10"

# debug | info | warn | error
LOG_LEVEL="info"

# User-Agent sent to provider APIs. The default is neutral on purpose: some
# providers (Intigriti is behind Cloudflare) return a 403 at the edge for
# bot-flagged agents. Override only if a provider needs a specific value.
PROVIDER_HTTP_USER_AGENT="Mozilla/5.0 (compatible; BBIAssetIntelligence/0.1)"
